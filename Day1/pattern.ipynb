   "source": [
    "n=int(input(\"n=\"))\n",
    "for i in range(n-1,-1,-1):\n",
    "  for j in range(0,i):\n",
    "    print(chr(65+j),end=\"\")\n",
    "    \n",
    "  if(i==n-1):\n",
    "    pass\n",
    "  else:\n",
    "    print(chr(65+i),end=\"\")\n",
    "    print(' '*(n-i-2),end=\"\")\n",
    "\n",
    "  print(' '*(n-i-1),end=\"\")\n",
    "  for j in range(i,-1,-1):\n",
    "    print(chr(65+j),end=\"\")\n",
    "  print()"
   ]
  }
